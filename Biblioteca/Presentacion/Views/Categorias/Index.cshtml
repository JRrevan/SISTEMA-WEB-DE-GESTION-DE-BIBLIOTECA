@model Biblioteca.Dominio.Categoria
@{
    ViewData["Title"] = "Estructura de Categorías";
    Layout = "~/Presentacion/Views/Shared/_Layout.cshtml";

    // Función local recursiva para renderizar las subcategorías utilizando los apuntadores de tu TDA
    void RenderArbol(Biblioteca.Dominio.Categoria categoriaActual)
    {
        var hijas = categoriaActual.Hijos.ObtenerOrdenadas();
        if (hijas != null && hijas.Cantidad > 0)
        {
            <ul>
                @{
                    var nodoHijo = hijas.Primero;
                    while (nodoHijo != null)
                    {
                        <li>
                            <strong>@nodoHijo.Dato.Nombre</strong>
                            @{ RenderArbol(nodoHijo.Dato); }
                        </li>
                        nodoHijo = nodoHijo.Siguiente;
                    }
                }
            </ul>
        }
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Organización del Catálogo</h2>
    <a asp-action="Crear" class="btn btn-primary">Agregar Categoría o Subcategoría</a>
</div>

<div class="mb-4">
    <a asp-controller="Categorias" asp-action="GraficoGeneral" class="btn btn-info text-white me-2">Ver Gráfico Global del Catálogo</a>
    <a asp-controller="Categorias" asp-action="GraficoArbolLibros" class="btn btn-info text-white">Ver AVL global de libros</a>
</div>

@if (TempData["Exito"] != null) { <div class="alert alert-success">@TempData["Exito"]</div> }
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-8">
                <label for="subcategoria" class="form-label">Catálogo existente</label>
                <select id="subcategoria" name="subcategoria" class="form-select">
                    <option value="">Raíz global</option>
                    @{ var nodoCategoria = ViewBag.Categorias.Primero; }
                    @while (nodoCategoria != null)
                    {
                        var categoria = nodoCategoria.Dato;
                        if (ViewBag.CategoriaSeleccionada == categoria.Nombre)
                        {
                            <option value="@categoria.Nombre" selected>@categoria.Nombre</option>
                        }
                        else
                        {
                            <option value="@categoria.Nombre">@categoria.Nombre</option>
                        }
                        nodoCategoria = nodoCategoria.Siguiente;
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-secondary w-100">Seleccionar catálogo</button>
            </div>
        </form>
        <form asp-controller="Categorias" asp-action="GraficoGeneral" method="get" class="row g-2 mt-3">
            <div class="col-md-8">
                <label for="categoriaArbol" class="form-label">Categoría raíz del gráfico jerárquico</label>
                <select id="categoriaArbol" name="subcategoria" class="form-select">
                    <option value="">Catálogo global</option>
                    @{ var nodoCategoriaGrafico = ViewBag.Categorias.Primero; }
                    @while (nodoCategoriaGrafico != null)
                    {
                        var categoria = nodoCategoriaGrafico.Dato;
                        <option value="@categoria.Nombre">@categoria.Nombre</option>
                        nodoCategoriaGrafico = nodoCategoriaGrafico.Siguiente;
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-info text-white w-100">Graficar categorías</button>
            </div>
        </form>
        <form asp-controller="Categorias" asp-action="GraficoLibros" method="get" class="row g-2 mt-3">
            <div class="col-md-8">
                <label for="categoriaGrafico" class="form-label">Categoría para graficar sus libros</label>
                <select id="categoriaGrafico" name="subcategoria" class="form-select" required>
                    <option value="">Seleccione una categoría</option>
                    @{ var nodoCategoriaLibros = ViewBag.Categorias.Primero; }
                    @while (nodoCategoriaLibros != null)
                    {
                        var categoria = nodoCategoriaLibros.Dato;
                        <option value="@categoria.Nombre">@categoria.Nombre</option>
                        nodoCategoriaLibros = nodoCategoriaLibros.Siguiente;
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-warning w-100">Graficar libros</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h5>
            @(Model.Padre == null ? "Raíz del Catálogo" : $"Vista partiendo desde: {Model.Nombre}")
        </h5>
        <hr />
        <div style="max-height: 500px; overflow-y: auto; font-family: monospace; font-size: 1.1em;">
            <ul>
                <li>
                    <strong>@(Model.Padre == null ? "Catálogo Global" : Model.Nombre)</strong>
                    @{ RenderArbol(Model); }
                </li>
            </ul>
        </div>
    </div>
</div>