@{
    ViewData["Title"] = "Gráfico de Libros por Categoría";
    Layout = "~/Presentacion/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Libros de la categoría: @ViewBag.NombreCategoria</h2>
    <a asp-action="Index" class="btn btn-secondary">Volver a organización</a>
</div>

<div class="card shadow-sm">
    <div class="card-body text-center overflow-auto" style="max-height: 70vh;">
        @if (ViewBag.RutaSvg != null)
        {
            <img src="@ViewBag.RutaSvg" alt="Gráfico de libros por categoría" class="img-fluid" />
        }
    </div>
</div>