@{
    ViewData["Title"] = "Gestión de Libros";
    Layout = "~/Presentacion/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestión de Libros</h2>
    <a asp-action="Crear" class="btn btn-primary">Registrar Nuevo Libro</a>
</div>

@if (TempData["Exito"] != null) { <div class="alert alert-success">@TempData["Exito"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Extremos del Catálogo</h5>
                <p><strong>Menor ISBN:</strong> @(ViewBag.Minimo != null ? $"{ViewBag.Minimo.Isbn} - {ViewBag.Minimo.Titulo}" : "Catálogo vacío")</p>
                <p><strong>Mayor ISBN:</strong> @(ViewBag.Maximo != null ? $"{ViewBag.Maximo.Isbn} - {ViewBag.Maximo.Titulo}" : "Catálogo vacío")</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Buscar Libro por ISBN</h5>
                <form asp-action="Index" method="get" class="d-flex mb-3">
                    <input type="number" name="isbnBusqueda" class="form-control me-2" placeholder="Ingrese ISBN" required />
                    <button type="submit" class="btn btn-secondary">Buscar</button>
                </form>
                
                @if (ViewBag.BusquedaRealizada == true)
                {
                    if (ViewBag.LibroBuscado != null)
                    {
                        <div class="alert alert-info">
                            <strong>ISBN:</strong> @ViewBag.LibroBuscado.Isbn <br/>
                            <strong>Título:</strong> @ViewBag.LibroBuscado.Titulo <br/>
                            <strong>Autor:</strong> @ViewBag.LibroBuscado.Autor <br/>
                            <strong>Categoría:</strong> @ViewBag.LibroBuscado.Categoria.RutaCompleta
                            
                            <form asp-action="Eliminar" method="post" class="mt-2" onsubmit="return confirm('¿Eliminar este libro definitivamente?');">
                                <input type="hidden" name="isbn" value="@ViewBag.LibroBuscado.Isbn" />
                                <button type="submit" class="btn btn-sm btn-danger w-100">Eliminar Libro</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">No se encontró el ISBN @ViewBag.IsbnBuscado.</div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title">Filtrar libros</h5>
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-5">
                <label for="categoria" class="form-label">Categoría</label>
                <select id="categoria" name="categoria" class="form-select">
                    <option value="">Todas las categorías</option>
                    @{ var nodoCategoria = ViewBag.Categorias.Primero; }
                    @while (nodoCategoria != null)
                    {
                        var categoria = nodoCategoria.Dato;
                        if (categoria.Padre != null && categoria.Padre.Padre == null)
                        {
                            if (ViewBag.CategoriaSeleccionada == categoria.Nombre)
                            {
                                <option value="@categoria.Nombre" selected>@categoria.Nombre</option>
                            }
                            else
                            {
                                <option value="@categoria.Nombre">@categoria.Nombre</option>
                            }
                        }
                        nodoCategoria = nodoCategoria.Siguiente;
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label for="subcategoria" class="form-label">Subcategoría</label>
                <select id="subcategoria" name="subcategoria" class="form-select">
                    <option value="">Todas las subcategorías</option>
                    @{ var nodoSubcategoria = ViewBag.Categorias.Primero; }
                    @while (nodoSubcategoria != null)
                    {
                        var categoria = nodoSubcategoria.Dato;
                        if (categoria.Padre != null && categoria.Padre.Padre != null)
                        {
                            if (ViewBag.SubcategoriaSeleccionada == categoria.Nombre)
                            {
                                <option value="@categoria.Nombre" selected>@categoria.RutaCompleta</option>
                            }
                            else
                            {
                                <option value="@categoria.Nombre">@categoria.RutaCompleta</option>
                            }
                        }
                        nodoSubcategoria = nodoSubcategoria.Siguiente;
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-secondary w-100">Filtrar</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title">Libros ordenados por ISBN</h5>
        @if (ViewBag.Libros != null && ViewBag.Libros.Cantidad > 0)
        {
            var actual = ViewBag.Libros.Primero;
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ISBN</th>
                            <th>Título</th>
                            <th>Autor</th>
                            <th>Categoría</th>
                        </tr>
                    </thead>
                    <tbody>
                        @while (actual != null)
                        {
                            <tr>
                                <td>@actual.Dato.Isbn</td>
                                <td>@actual.Dato.Titulo</td>
                                <td>@actual.Dato.Autor</td>
                                <td>@actual.Dato.Categoria.RutaCompleta</td>
                            </tr>
                            actual = actual.Siguiente;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="mb-0">No hay libros registrados.</p>
        }
    </div>
</div>