<form asp-action="Crear" method="post">
    <input type="number" name="isbn" class="form-control mb-2" placeholder="ISBN" required />
    <input type="text" name="titulo" class="form-control mb-2" placeholder="Título" required />
    <input type="text" name="autor" class="form-control mb-2" placeholder="Autor" required />
    <input type="text" name="categoria" class="form-control mb-3" placeholder="Nombre de la Categoría Existente" required />
    <button type="submit" class="btn btn-success">Registrar</button>
</form>